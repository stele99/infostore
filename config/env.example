# Beispielkonfiguration - Werte als Umgebungsvariablen setzen
# (z. B. in der Webserver-Konfiguration oder via config/local.php, gitignored).
# Es gehören KEINE echten Pfade oder Geheimnisse ins Repository.

# SQLite-Datei AUSSERHALB des Document Root
INFOSTORE_DB=/pfad/ausserhalb/webroot/var/data.sqlite3

# Logverzeichnis (geschützt, nicht öffentlich erreichbar)
INFOSTORE_LOG_DIR=/pfad/ausserhalb/webroot/var/log

# Serverseitiges Geheimnis für Decoy-Salts (Datei wird automatisch erzeugt)
INFOSTORE_SECRET_FILE=/pfad/ausserhalb/webroot/var/app_secret

# Mailversand: "file" (Default, schreibt .eml nach INFOSTORE_MAIL_DIR),
# "native" (PHP mail() - landet oft im Spam) oder "smtp" (eigenes Postfach, empfohlen).
INFOSTORE_MAIL=smtp
INFOSTORE_MAIL_DIR=/pfad/ausserhalb/webroot/var/mail
INFOSTORE_MAIL_FROM=infostore@deine-domain.de
INFOSTORE_MAIL_FROM_NAME=Secure Info Store

# Nur relevant wenn INFOSTORE_MAIL=smtp. Zugangsdaten des Postfachs, ueber das
# versendet werden soll - NIEMALS ins Repository, nur als Umgebungsvariable
# oder in config/local.php (gitignored) setzen.
INFOSTORE_SMTP_HOST=mail.deine-domain.de
INFOSTORE_SMTP_PORT=587
# starttls (Port meist 587) oder tls (implizites TLS, Port meist 465) oder none
INFOSTORE_SMTP_ENCRYPTION=starttls
INFOSTORE_SMTP_USERNAME=postfach@deine-domain.de
INFOSTORE_SMTP_PASSWORD=hier-das-postfach-passwort
INFOSTORE_SMTP_TIMEOUT=10
