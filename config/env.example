# Beispielkonfiguration - Werte als Umgebungsvariablen setzen
# (z. B. in der Webserver-Konfiguration oder via config/local.php, gitignored).
# Es gehören KEINE echten Pfade oder Geheimnisse ins Repository.

# SQLite-Datei AUSSERHALB des Document Root
INFOSTORE_DB=/pfad/ausserhalb/webroot/var/data.sqlite3

# Logverzeichnis (geschützt, nicht öffentlich erreichbar)
INFOSTORE_LOG_DIR=/pfad/ausserhalb/webroot/var/log

# Serverseitiges Geheimnis für Decoy-Salts (Datei wird automatisch erzeugt)
INFOSTORE_SECRET_FILE=/pfad/ausserhalb/webroot/var/app_secret

# Mailversand: "file" (Default, schreibt .eml nach INFOSTORE_MAIL_DIR) oder "native" (PHP mail())
INFOSTORE_MAIL=file
INFOSTORE_MAIL_DIR=/pfad/ausserhalb/webroot/var/mail
INFOSTORE_MAIL_FROM=infostore@example.org
